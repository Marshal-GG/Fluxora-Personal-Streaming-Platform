# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/
*.spec.bak

# Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
*.iml
.idea/
.vscode/*
.claude/scheduled_tasks.lock
.claude/settings.local.json
!.vscode/launch.json
!.vscode/tasks.json
build/

# Native build caches (per-machine, non-deterministic)
.gradle/
**/android/.gradle/
**/linux/flutter/ephemeral/
**/macos/Flutter/ephemeral/
**/ios/Flutter/ephemeral/

# Local scratch / experimentation — never committed
scratch/
.tmp_design_fetch/

# OS
.DS_Store
Thumbs.db

# Secrets
*.env
.env
config.json
google-services.json
GoogleService-Info.plist

# Obfuscation debug symbols (keep privately for crash symbolication)
build/debug-info/

# Next.js (web_landing)
apps/web_landing/.next/
apps/web_landing/out/
apps/web_landing/node_modules/

# TypeScript incremental build cache (never committed)
*.tsbuildinfo

# Firebase
functions/node_modules/
functions/lib/
.firebase/

# Fluxora runtime
*.db
*.db-shm
*.db-wal
/tmp/fluxora/
~/.fluxora/
apps/server/tmp/

# FFmpeg HLS init segment that older bundled builds occasionally drop in
# the server-process cwd before _spawn_ffmpeg_attempt's cwd= override
# kicked in.  Defensive — should never appear with current code.
apps/server/init.mp4

# Flutter golden-test diff artifacts (transient, regenerated on every
# failing run; the canonical goldens live in apps/desktop/test/goldens/
# itself, not under failures/).
apps/desktop/test/goldens/failures/

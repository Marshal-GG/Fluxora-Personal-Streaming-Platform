<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <!-- QR-code pairing scanner — `mobile_scanner` opens the camera to read
         the QR rendered by the desktop control panel.  Camera is only
         used when the user opens the Scan-QR screen from /connect; not
         used anywhere else in the app. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <!-- audio_service foreground-service requirements.  The first two
         are mandatory on every Android version; the *_MEDIA_PLAYBACK one
         is the API-34 (Android 14) split-permission for media foreground
         services and is harmless on older platforms. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Android 13 (API 33) and newer require an explicit runtime
         grant before any app can post foreground-service
         notifications.  The Media3 MediaSessionService below (and the
         existing audio_service AudioService) both rely on a persistent
         notification to keep the lockscreen / shade transport card
         alive.  Without this permission declared, the user can still
         play media but the lockscreen card never appears on Android
         13+ devices.  The grant itself is requested at first-playback
         time via the platform's standard permission flow — see the
         user-grant tracking in `audio_service`, which already covers
         both services. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="Fluxora"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- audio_service foreground service.  Hosts the MediaSession that
             surfaces the lockscreen / shade / Bluetooth-headset transport
             controls and keeps the player process alive while the app is
             in the background.  `foregroundServiceType="mediaPlayback"`
             is the only currently-allowed type for media playback per
             Android 14's foreground-service split. -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Bluetooth-headset / wired-headset media-button receiver.
             Without this the system can't route Play/Pause key events
             from external hardware to our session. -->
        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Media3 MediaSessionService.  Surfaces the active
             ExoPlayer's playback to the OS media-session layer
             (lockscreen card, notification, BT headset transport, Android
             Auto / WearOS).  Replaces audio_service's binding for
             ExoPlayerEngine sessions; the MediaKitEngine path keeps using
             the AudioService declared above (the cubit gates which one
             is active based on the engine type).
             `foregroundServiceType="mediaPlayback"` matches AudioService
             above and uses the same FOREGROUND_SERVICE_MEDIA_PLAYBACK
             permission already declared in <uses-permission>.
             `exported="true"` is required so system UI (lockscreen,
             notification shade) and Android Auto / Wear can resolve our
             session.  The intent-filter advertises the standard Media3
             session-service action — system components match against it. -->
        <service
            android:name=".exo.FluxoraMediaSessionService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>

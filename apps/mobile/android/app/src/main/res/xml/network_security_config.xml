<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9+ blocks cleartext globally by default.  libmpv (via
  media_kit) used its own HTTP stack and bypassed the policy; Media3
  ExoPlayer goes through Android's network stack and respects it,
  so without this file ExoPlayer fails every LAN stream with
  CleartextNotPermittedException.

  Fluxora's LAN-streaming path was designed to work cleartext over
  the user's home network — server IPs are dynamic RFC1918 / link-
  local addresses discovered via mDNS, which `<domain>` cannot
  scope (the element only matches DNS hostnames, not CIDR/IP
  ranges).  So the base-config permits cleartext globally and we
  carve HTTPS-only out for the public WAN tunnel hostname that
  ApiClient is configured to talk to off-LAN.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>

    <!-- Public WAN tunnel — HTTPS-only.  Belt-and-braces with the
         Dart-side ApiClient which already forces HTTPS for the
         remote base URL.  If you ever move the tunnel to a new
         hostname, add it here too. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">fluxora-api.marshalx.dev</domain>
    </domain-config>
</network-security-config>
